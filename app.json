{
  "expo": {
    "name": "Fairway Chaos",
    "slug": "golf-app",
    "scheme": "golfapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "owner": "antonbergenudd",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#071209"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.antonbergenudd.fairwaychaos",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.antonbergenudd.fairwaychaos",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#071209"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cb471cd4-27b1-42f9-9fa4-2c147ed875de"
      }
    }
  }
}
