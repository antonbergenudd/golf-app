# Copy to `.env` in the project root (do not commit `.env`).
# 1. Create a project at https://supabase.com (free tier is fine).
# 2. Project Settings → API → copy Project URL and anon public key below.
# 3. SQL Editor → run migrations in order from supabase/migrations/*.sql
#    (or: supabase link && supabase db push if you use the CLI).
# If lobby create fails with "fetch failed" / "Cannot reach Supabase", the URL
# points at a deleted or wrong project — create a new project and update these values.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Store / EAS builds do not read this file. Set the same two keys as EAS
# environment variables for the production profile (expo.dev → Project → Environment variables)
# or the production binary will ship without a Supabase backend.
